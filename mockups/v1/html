/* ------------------------------------------------------------------ grid */
class G {
  constructor(w, h) { this.w = w; this.h = h; this.c = []; for (let y = 0; y < h; y++) { const r = []; for (let x = 0; x < w; x++) r.push([" ", ""]); this.c.push(r); } }
  put(x, y, t, cls = "") { if (y < 0 || y >= this.h) return x + len(t); for (const ch of t) { if (x >= this.w) break; if (x >= 0) this.c[y][x] = [ch, cls]; x++; } return x; }
  rput(xr, y, t, cls = "") { return this.put(xr - len(t) + 1, y, t, cls); }
  segs(x, y, parts) { for (const [t, c] of parts) x = this.put(x, y, t, c); return x; }
  rsegs(xr, y, parts) { const n = parts.reduce((a, [t]) => a + len(t), 0); return this.segs(xr - n + 1, y, parts); }
  bg(x1, x2, y, extra) { if (y < 0 || y >= this.h) return; for (let x = Math.max(0, x1); x <= Math.min(this.w - 1, x2); x++) { const [ch, c] = this.c[y][x]; this.c[y][x] = [ch, (c + " " + extra).trim()]; } }
  setcls(x1, x2, y, cls) { for (let x = x1; x <= x2; x++) if (x >= 0 && x < this.w) this.c[y][x] = [this.c[y][x][0], cls]; }
  hl(x1, x2, y, cls = "dim", ch = "─") { for (let x = x1; x <= x2; x++) if (x >= 0 && x < this.w) this.c[y][x] = [ch, cls]; }
  vl(x, y1, y2, cls = "dim", ch = "│") { for (let y = y1; y <= y2; y++) if (y >= 0 && y < this.h) this.c[y][x] = [ch, cls]; }
  clear(x, y, w, h) { for (let yy = y; yy < y + h; yy++) for (let xx = x; xx < x + w; xx++) if (yy >= 0 && yy < this.h && xx >= 0 && xx < this.w) this.c[yy][xx] = [" ", ""]; }
  box(x, y, w, h, cls = "dim", tparts = null) {
    this.put(x, y, "┌" + "─".repeat(w - 2) + "┐", cls);
    this.put(x, y + h - 1, "└" + "─".repeat(w - 2) + "┘", cls);
    for (let yy = y + 1; yy < y + h - 1; yy++) { this.c[yy][x] = ["│", cls]; this.c[yy][x + w - 1] = ["│", cls]; }
    if (tparts) { this.put(x + 1, y, " ", cls); const e = this.segs(x + 2, y, tparts); this.put(e, y, " ", cls); }
  }
  dbox(x, y, w, h, cls) {
    this.put(x, y, "┌" + "┄".repeat(w - 2) + "┐", cls);
    this.put(x, y + h - 1, "└" + "┄".repeat(w - 2) + "┘", cls);
    for (let yy = y + 1; yy < y + h - 1; yy++) { this.c[yy][x] = ["┆", cls]; this.c[yy][x + w - 1] = ["┆", cls]; }
  }
  render() {
    let out = "";
    for (const row of this.c) {
      let line = "", cur = null, buf = "";
      const flush = () => { if (buf) line += cur ? `<span class="${cur}">${buf}</span>` : buf; };
      for (const [ch, c] of row) {
        if (c !== cur) { flush(); buf = ""; cur = c; }
        const o = ch.codePointAt(0);
        if (o < 128) buf += esc(ch);
        else buf += `<b class="g">${esc(ch)}</b>`;
      }
      flush();
      out += `<div class="ln">${line}</div>`;
    }
    return out;
  }
}


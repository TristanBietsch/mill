function spatial(items, curId, dx, dy) {
  const cur = items.find(i => i.id === curId); if (!cur) return null;
  let best = null, bd = 1e9;
  for (const it of items) {
    if (it.id === curId) continue;
    let d;
    if (dy) {
      if (dy > 0 ? it.y1 <= cur.y2 : it.y2 >= cur.y1) continue;
      if (Math.min(it.x2, cur.x2) < Math.max(it.x1, cur.x1)) continue;   // must share the column
      d = dy > 0 ? it.y1 - cur.y2 : cur.y1 - it.y2;
    } else {
      if (dx > 0 ? it.x1 <= cur.x2 : it.x2 >= cur.x1) continue;
      if (Math.min(it.y2, cur.y2) < Math.max(it.y1, cur.y1)) continue;   // must share the row
      d = dx > 0 ? it.x1 - cur.x2 : cur.x1 - it.x2;
    }
    if (d < bd) { bd = d; best = it; }
  }
  return best;
}

